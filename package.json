{
  "name": "@perspective-software/cli",
  "version": "0.1.0",
  "description": "Command-line interface for the Perspective External API",
  "license": "MIT",
  "keywords": [
    "perspective",
    "cli",
    "funnels",
    "agents",
    "claude-code",
    "skill"
  ],
  "homepage": "https://developers.perspective.co/cli/overview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Perspective-Software/perspective-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Perspective-Software/perspective-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "perspective": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
