{
  "name": "@perspective-software/cli",
  "version": "0.1.0",
  "description": "Command-line interface for the Perspective External API and MCP server",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "perspective": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
